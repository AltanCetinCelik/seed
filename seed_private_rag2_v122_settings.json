{
    "version": "v122.0.0",
    "extensions": [
        ".py",
        ".md",
        ".txt",
        ".json"
    ],
    "max_file_kb": 220,
    "chunk_chars": 1200,
    "modes": {
        "seed": {
            "roots": [
                "."
            ],
            "exclude_dirs": [
                "third_party_repos",
                "seed_checkpoints",
                ".git",
                "__pycache__",
                "node_modules",
                "venv",
                ".venv"
            ]
        },
        "audit": {
            "roots": [
                "third_party_repos"
            ],
            "exclude_dirs": [
                ".git",
                "node_modules",
                "venv",
                ".venv"
            ]
        }
    }
}